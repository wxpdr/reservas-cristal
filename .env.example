# Backend
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/reservas_cristal
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_NAME=cristal_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
PASSWORD_TOKEN_TTL_HOURS=24
# Configure both in the Render backend environment; never commit a real API key.
# Leave both unset for local logging delivery.
# BREVO_API_KEY=
# EMAIL_FROM=reservas@seudominio.com
EMAIL_FROM_NAME=Reservas Cristal
# SMTP opcional para desenvolvimento local; nao utilizado no Render Free.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=conta-de-teste@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=conta-de-teste@gmail.com

# Frontend (Next.js server proxy; configure in frontend/.env.local or the hosting environment)
BACKEND_URL=http://localhost:8000
